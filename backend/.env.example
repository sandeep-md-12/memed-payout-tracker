NODE_ENV=development
PORT=4000

# Payouts use MongoDB transactions, which need a replica set.
# Local Docker Mongo runs as a single-node replica set; MongoDB Atlas URIs work as-is.
MONGODB_URI=mongodb://localhost:27017/memed?directConnection=true

# Production requires at least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call the API (or * for any).
CORS_ORIGIN=http://localhost:3000

# Optional. Caches the live-campaign list; the app works without it.
# REDIS_URL=redis://localhost:6379

# Spike rule: at least SPIKE_MIN_GAIN new views arriving faster than SPIKE_MAX_VIEWS_PER_HOUR
# flags a Submission and pauses its payouts until the Brand approves or rejects it.
SPIKE_MIN_GAIN=5000
SPIKE_MAX_VIEWS_PER_HOUR=50000
